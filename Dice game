using System;
using System.Text;

namespace GameApp
{
    class Program
    {
        static void CalculateScore(Random random, string playerName, int dice1, int dice2, out int turnPoints)
        {
            if (dice1 == dice2)
            {
                if (dice1 < 2) // Double ones (simpler check since dice1 == dice2)
                {
                    turnPoints = 0;
                }
                else {
                    int dice3 = random.Next(1, 7);
                    Console.WriteLine($"{playerName} rolled a {dice3}");
                    
                    turnPoints = dice1 + dice2 + dice3;
                }
            }
            else
            {
                turnPoints = dice1 + dice2;
            }
        }

        // Handles a player's turn and returns whether they've won
        static bool ProcessTurn(Random random, string playerName, ref int totalPoints, bool isEnemy = false)
        {
            // Roll dice
            int dice1 = random.Next(1, 7);
            Console.WriteLine($"{playerName} {(isEnemy ? "rolled" : "rolled")} a {dice1}");
            
            int dice2 = random.Next(1, 7);
            Console.WriteLine($"{playerName} {(isEnemy ? "rolled" : "rolled")} a {dice2}");
            
            // Calculate score
            int turnPoints;
            CalculateScore(random, playerName, dice1, dice2, out turnPoints);
            
            // Handle score update
            if (dice1 == dice2 && dice1 < 2)
            {
                totalPoints = 0;
            }
            else
            {
                totalPoints += turnPoints;
            }
            
            // Display results
            Console.WriteLine($"{playerName}'s score of this row is {turnPoints}");
            Console.WriteLine($"{playerName}'s total Score is {totalPoints}");
            
            // Return true if player has won
            return totalPoints >= 101;
        }

        static void Main(string[] args)
        {
            Console.WriteLine("Enter your name...");
            string player = Console.ReadLine();
            Console.WriteLine($"Hello {player}");

            int playerPoints = 0;
            int enemyPoints = 0;
            Random random = new Random();

            bool gameOver = false;
            while (!gameOver)
            {
                Console.WriteLine("--------------------------------");
                Console.WriteLine("Press any key to roll the Dice.");
                Console.WriteLine("--------------------------------");
                Console.ReadKey();
                
                // Player's turn
                if (ProcessTurn(random, player, ref playerPoints))
                {
                    gameOver = true;
                    break;
                }

                Console.WriteLine("++++++++++++++++++++++++++++++++");
                
                System.Threading.Thread.Sleep(1000);

                // Enemy's turn
                if (ProcessTurn(random, "Enemy", ref enemyPoints, true))
                {
                    gameOver = true;
                }
            }

            // Use StringBuilder for multiple consecutive string operations
            StringBuilder sb = new StringBuilder();
            sb.AppendLine("<<<<<<<<< SCORE >>>>>>>>");
            sb.AppendLine($"{player} : {playerPoints}   Enemy :{enemyPoints}");
            
            sb.AppendLine("********************************");
            if (playerPoints > enemyPoints)
            {
                sb.AppendLine($"{player} you win the game!");
            }
            else if (playerPoints < enemyPoints)
            {
                sb.AppendLine("Enemy wins this round!");
            }
            else
            {
                sb.AppendLine("Draw!");
            }
            sb.AppendLine("********************************");
            
            Console.Write(sb.ToString());
            Console.ReadKey();
        }
    }
}
