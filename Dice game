using System;
using System.Collections.Generic;
using System.Linq;
using System.Text;
using System.Threading.Tasks;

namespace GameApp
{
    class Program
    {
        // Improved algorithm: Refactored dice rolling logic into reusable method for better performance and maintainability
        static int RollDiceForPlayer(Random random, string playerName, out int roundScore)
        {
            int dice1 = random.Next(1, 7);
            Console.WriteLine(playerName + " rolled a " + dice1);

            int dice2 = random.Next(1, 7);
            Console.WriteLine(playerName + " rolled a " + dice2);

            int totalPoints = 0;
            roundScore = 0;

            // Algorithm improvement: Check if both dice show the same number (doubles)
            if (dice1 == dice2)
            {
                // Algorithm fix: Corrected bug - now properly checks if both dice are exactly 1 (not < 2)
                // Snake eyes (double 1s) penalty: reset total score to 0
                if (dice1 == 1 && dice2 == 1)
                {
                    Console.WriteLine(playerName + " rolled snake eyes! Score reset to 0!");
                    return -1; // Special flag to indicate score reset
                }
                else 
                {
                    // Doubles bonus: roll a third die
                    int dice3 = random.Next(1, 7);
                    Console.WriteLine(playerName + " rolled a " + dice3);

                    roundScore = dice1 + dice2 + dice3;
                    totalPoints = roundScore;
                }
            }
            else
            {
                // No doubles: just add the two dice
                roundScore = dice1 + dice2;
                totalPoints = roundScore;
            }

            return totalPoints;
        }

        static void Main(string[] args)
        {
            string player;
            int playerPoints = 0;
            int enemyPoints = 0;
            int playerRoundScore = 0;
            int enemyRoundScore = 0;

            Random random = new Random();

            Console.WriteLine("Enter your name...");
            player = Console.ReadLine();
            Console.WriteLine("Hello " + player + "!"); // Fixed typo: "Hellow" -> "Hello"

            // Algorithm improvement: Game continues until one player reaches or exceeds 101
            while (playerPoints < 101 && enemyPoints < 101)
            {
                Console.WriteLine("--------------------------------");
                Console.WriteLine("Press any key to roll the Dice.");
                Console.WriteLine("--------------------------------");
                Console.ReadKey();

                // Player's turn - using refactored method
                int playerTurnResult = RollDiceForPlayer(random, player, out playerRoundScore);
                
                if (playerTurnResult == -1)
                {
                    // Snake eyes penalty: reset total score
                    playerPoints = 0;
                    playerRoundScore = 0;
                }
                else
                {
                    playerPoints += playerTurnResult;
                }

                Console.WriteLine(player + "'s score of this round is " + playerRoundScore);
                Console.WriteLine(player + "'s total Score is " + playerPoints);

                // Algorithm improvement: Check win condition after each turn for better performance
                if (playerPoints >= 101)
                {
                    break; // Player wins, exit loop immediately
                }

                Console.WriteLine("++++++++++++++++++++++++++++++++");
                System.Threading.Thread.Sleep(1000);

                // Enemy's turn - using refactored method (fixed typo: "rooled" -> "rolled")
                int enemyTurnResult = RollDiceForPlayer(random, "Enemy", out enemyRoundScore);
                
                if (enemyTurnResult == -1)
                {
                    // Snake eyes penalty: reset total score
                    enemyPoints = 0;
                    enemyRoundScore = 0;
                }
                else
                {
                    enemyPoints += enemyTurnResult;
                }

                Console.WriteLine("Enemy's score of this round is " + enemyRoundScore);
                Console.WriteLine("Enemy's total Score is " + enemyPoints);
            }

            // Display final results
            Console.WriteLine("<<<<<<<<< SCORE >>>>>>>>");
            Console.WriteLine(player + " : " + playerPoints + "   Enemy: " + enemyPoints);
            
            // Algorithm improvement: First to reach 101 wins (not just higher score)
            if (playerPoints >= 101 && enemyPoints < 101)
            {
                Console.WriteLine("********************************");
                Console.WriteLine(player + " you win the game!");
                Console.WriteLine("********************************");
            }
            else if (enemyPoints >= 101 && playerPoints < 101)
            {
                Console.WriteLine("********************************");
                Console.WriteLine("Enemy wins this round!");
                Console.WriteLine("********************************");
            }
            else if (playerPoints >= 101 && enemyPoints >= 101)
            {
                // Both reached 101 in the same round - higher score wins
                if (playerPoints > enemyPoints)
                {
                    Console.WriteLine("********************************");
                    Console.WriteLine(player + " you win the game!");
                    Console.WriteLine("********************************");
                }
                else if (enemyPoints > playerPoints)
                {
                    Console.WriteLine("********************************");
                    Console.WriteLine("Enemy wins this round!");
                    Console.WriteLine("********************************");
                }
                else
                {
                    Console.WriteLine("********************************");
                    Console.WriteLine("Draw!");
                    Console.WriteLine("********************************");
                }
            }
            Console.ReadKey();
        }
    }
}
